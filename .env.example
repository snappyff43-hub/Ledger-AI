# LocalLedger AI - Environment Configuration Example
# Copy this file to .env if you wish to set local variables.
# Note: LocalLedger AI runs 100% locally with Ollama by default and requires NO external API keys.

# Optional: Custom Ollama endpoint (Default: http://127.0.0.1:11434)
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional: Only needed if you explicitly choose to run the separate benchmark script (compare_models.py)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash
